# Copy this file to .env and enter your key(s). .env is never committed.
# One line per key, numbered consecutively from 1 (use as many keys as you have, 1 to 4).
# The limits (400 per hour, 800 per day) apply per key, so more keys = more requests per day.
# A single old-style SAIA_API_KEY= line still works if no numbered key is set.
SAIA_API_KEY_1=
SAIA_API_KEY_2=
